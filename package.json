{
  "name": "textus-plugins",
  "private": true,
  "version": "0.0.0",
  "description": "The plugins Textus offers to install: their sources, and the packages and catalog Textus downloads.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck:cloud-sync && node scripts/cloud-sync.mjs --check && node scripts/build.mjs --check && vitest run",
    "vendor": "node scripts/vendor.mjs",
    "typecheck:cloud-sync": "tsc --noEmit -p development/cloud-sync/tsconfig.json",
    "build:cloud-sync": "node scripts/cloud-sync.mjs",
    "test:e2e:cloud-sync": "playwright test -c e2e/cloud-sync/playwright.config.ts"
  },
  "devDependencies": {
    "@marp-team/marp-core": "4.4.0",
    "@plantuml/core": "1.2026.9",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "abcjs": "6.7.2",
    "aws4fetch": "1.0.20",
    "chart.js": "4.5.1",
    "d3": "7.9.0",
    "docx-preview": "0.4.1",
    "echarts": "6.1.0",
    "esbuild": "0.25.11",
    "jszip": "3.10.2",
    "markdownlint": "0.42.0",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "pdfjs-dist": "6.4.299",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wavedrom": "3.8.0"
  }
}
