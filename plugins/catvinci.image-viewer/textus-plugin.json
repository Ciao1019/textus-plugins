{
  "id": "catvinci.image-viewer",
  "name": "%name%",
  "version": "0.2.0",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": ">=1.3.2"
  },
  "platforms": ["desktop", "ios"],
  "main": "host.js",
  "permissions": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "catvinci.image-viewer.image",
        "displayName": "%name%",
        "filenamePatterns": [
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.gif",
          "*.webp",
          "*.avif",
          "*.bmp",
          "*.ico",
          "*.svg"
        ]
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Image Viewer",
      "description": "Open pictures and SVG files in a tab: zoom, fit, and an SVG's source.",
