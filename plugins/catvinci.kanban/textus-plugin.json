{
  "id": "catvinci.kanban",
  "name": "%name%",
  "version": "0.2.0",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": ">=1.3.2"
  },
  "platforms": ["desktop", "ios"],
  "main": "host.js",
  "permissions": [
    "files.read",
    "files.write"
  ],
  "contributes": {
    "commands": [
      {
        "command": "catvinci.kanban.new",
        "title": "%new%"
      }
    ],
    "menus": {
      "app/plugins": [
        {
          "command": "catvinci.kanban.new"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "catvinci.kanban.board",
        "displayName": "%name%",
        "filenamePatterns": [
          "*.kanban.md"
        ]
      }
    ]
  },
