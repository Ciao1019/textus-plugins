{
  "id": "catvinci.templates",
  "name": "%name%",
  "version": "0.1.3",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": ">=1.3.0-beta.2"
  },
  "platforms": ["desktop", "ios"],
  "main": "host.js",
  "permissions": ["files.read", "files.write", "editor.read", "editor.write"],
  "contributes": {
    "commands": [
      {
        "command": "catvinci.templates.new",
        "title": "%new%"
      },
      {
        "command": "catvinci.templates.insert",
        "title": "%insert%"
      },
      {
        "command": "catvinci.templates.save",
        "title": "%save%"
      }
    ],
    "menus": {
      "app/plugins": [
        {
          "command": "catvinci.templates.new"
        },
        {
          "command": "catvinci.templates.insert"
        },
        {
          "command": "catvinci.templates.save"
        }
      ],
      "editor/slash": [
        {
          "command": "catvinci.templates.insert"
        }
      ],
      "file/context": [
        {
          "command": "catvinci.templates.new"
        }
      ]
    }
  },
