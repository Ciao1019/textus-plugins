{
  "id": "catvinci.writing-stats",
  "name": "%name%",
  "version": "0.1.1",
  "publisher": "catvinci",
  "author": "CatVinci Studio",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/textus-plugins",
  "engines": {
    "textus": ">=1.3.0-beta.6"
  },
  "platforms": ["desktop", "ios"],
  "main": [
    "count.js",
    "host.js"
  ],
  "permissions": [
    "editor.read",
    "files.read"
  ],
  "contributes": {
    "sidebarTabs": [
      {
        "id": "catvinci.writing-stats.panel",
        "title": "%name%",
        "icon": "tab.svg",
        "type": "list"
      }
    ],
    "settings": [
      {
        "key": "goal",
        "type": "number",
        "default": 500,
        "title": "%goal%"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Writing Stats",
      "description": "Words and characters in the document and the selection, reading time, what you wrote today against a daily goal, the days in a row you met it, and the whole folder - CJK counted by character.",
